<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.TaakOverviewController">
   <center>
      <TableView fx:id="taakTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="56.0" text="TaakID" />
          <TableColumn fx:id="typeCol" prefWidth="149.0" text="Type" />
            <TableColumn fx:id="omschrijvingCol" prefWidth="279.0" text="Omschrijving" />
            <TableColumn fx:id="duurtijdCol" prefWidth="115.0" text="Duurtijd" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="addBtn" mnemonicParsing="false" onAction="#onAdd" text="+" />
            <Button fx:id="editBtn" mnemonicParsing="false" onAction="#onEdit" text="Wijzig" />
            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" text="Verwijder" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
             <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#onRefresh" text="">
                 <graphic>
                     <FontIcon iconLiteral="fas-sync-alt"/>
                 </graphic>
             </Button>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
