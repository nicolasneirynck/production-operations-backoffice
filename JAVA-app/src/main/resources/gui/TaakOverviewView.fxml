<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="300.0" minWidth="500.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.TaakOverviewController">
   <center>
      <TableView fx:id="taakTable" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="56.0" text="TaakID" />
          <TableColumn fx:id="typeCol" prefWidth="149.0" text="Type" />
            <TableColumn fx:id="omschrijvingCol" prefWidth="279.0" text="Omschrijving" />
            <TableColumn fx:id="duurtijdCol" prefWidth="115.0" text="Duurtijd" />
        </columns>
      </TableView>
   </center>
   <top>
      <Label text="Taken Beheren" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </Label>
   </top>
   <bottom>
      <BorderPane BorderPane.alignment="CENTER">
         <left>
            <HBox spacing="10.0" BorderPane.alignment="CENTER_LEFT">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Button fx:id="addBtn" mnemonicParsing="false" onAction="#onAdd" text="+" />
                  <Button fx:id="editBtn" mnemonicParsing="false" onAction="#onEdit" text="Wijzig" />
                  <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" text="Verwijder" />
               </children>
            </HBox>
         </left>
         <right>
            <HBox spacing="10.0" BorderPane.alignment="CENTER_RIGHT">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <TextField promptText="Zoeken.." />
                   <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#onRefresh" text="">
                       <graphic>
                           <FontIcon iconLiteral="fas-sync-alt"/>
                       </graphic>
                   </Button>
<!--                   zet lijn hieronder uit commentaar om met scenebuilder te werken -->
<!--                   <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#onRefresh" text="Ververs" />-->
               </children>
            </HBox>
         </right>
      </BorderPane>
   </bottom>
</BorderPane>
