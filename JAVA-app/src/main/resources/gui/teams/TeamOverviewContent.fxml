<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.teams.TeamOverviewController"
      spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Teams beheren" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addBtn"
                text="+ Maak een nieuw team"
                onAction="#onAdd"
                styleClass="btn-primary"/>
    </HBox>

    <VBox fx:id="formHost"
          spacing="12"
          visible="false"
          managed="false"/>

    <TableView fx:id="teamTable" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="siteCol" text="Site" prefWidth="180"/>
            <TableColumn fx:id="verantwoordelijkeCol" text="Verantwoordelijke" prefWidth="220"/>
            <TableColumn fx:id="medewerkersCol" text="Medewerkers" prefWidth="420"/>
            <TableColumn fx:id="actiesCol" text="Acties" prefWidth="160"/>
        </columns>
    </TableView>

</VBox>