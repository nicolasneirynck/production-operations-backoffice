<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.teams.TeamFormController"
      spacing="14">

    <styleClass>
        <String fx:value="card"/>
        <String fx:value="form-card"/>
    </styleClass>

    <Label fx:id="titleLabel" text="Nieuw team" styleClass="card-title"/>

    <!-- Bovenste blok -->
    <VBox spacing="12">

        <GridPane hgap="18" vgap="8">
            <columnConstraints>
                <ColumnConstraints percentWidth="40"/>
                <ColumnConstraints percentWidth="60"/>
            </columnConstraints>

            <!-- headers -->
            <Label text="Site"
                   styleClass="section-title"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <Label text="Verantwoordelijke"
                   styleClass="section-title"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

            <!-- site select -->
            <VBox spacing="2"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="0">
                <ComboBox fx:id="siteCb"
                          maxWidth="Infinity"
                          styleClass="form-combo"/>
                <Label fx:id="siteErr" styleClass="error-label"/>
            </VBox>

            <!-- verantwoordelijke badge -->
            <VBox spacing="2"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="verantwoordelijkeBadge"
                           text="-"
                           styleClass="employee-badge"/>
                </HBox>
                <Label fx:id="verantwoordelijkeErr" styleClass="error-label"/>
            </VBox>
        </GridPane>

        <!-- zoek -->
        <VBox spacing="2">
            <TextField fx:id="zoekTf"
                       promptText="Zoek medewerker..."
                       maxWidth="260"/>
            <Label fx:id="medewerkersErr" styleClass="error-label"/>
        </VBox>
    </VBox>

    <!-- onderste blok -->
    <HBox spacing="18">

        <!-- beschikbare medewerkers -->
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Beschikbare medewerkers" styleClass="section-title"/>

            <TableView fx:id="beschikbaarTable"
                       VBox.vgrow="ALWAYS"
                       styleClass="table">
                <columns>
                    <TableColumn fx:id="naamCol" text="Naam" prefWidth="150"/>
                    <TableColumn fx:id="voornaamCol" text="Voornaam" prefWidth="130"/>
                    <TableColumn fx:id="addCol" text="" prefWidth="70"/>
                </columns>
            </TableView>
        </VBox>

        <!-- geselecteerde medewerkers -->
        <VBox spacing="8" prefWidth="240" minWidth="240">
            <Label text="Medewerkers" styleClass="section-title"/>

            <ScrollPane fitToWidth="true"
                        prefHeight="220"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="team-scroll">
                <content>
                    <FlowPane fx:id="selectedPane"
                              hgap="8"
                              vgap="8"
                              prefWrapLength="210"/>
                </content>
            </ScrollPane>
        </VBox>
    </HBox>

    <!-- buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn"
                text="Annuleren"
                onAction="#onCancel"
                styleClass="btn-ghost"/>

        <Button fx:id="saveBtn"
                text="Opslaan"
                onAction="#onSave"
                styleClass="btn-primary"/>
    </HBox>

</VBox>