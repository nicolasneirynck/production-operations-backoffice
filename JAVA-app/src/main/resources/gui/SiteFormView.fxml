<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="10.0" vgap="6.0"
          prefHeight="420.0" prefWidth="600.0"
          xmlns="http://javafx.com/javafx/17.0.6"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="gui.SiteFormController">

    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" minWidth="160.0"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"/>
    </columnConstraints>

    <!-- 0: naam input -->
    <!-- 1: naam error -->
    <!-- 2: locatie input -->
    <!-- 3: locatie error -->
    <!-- 4: capaciteit input -->
    <!-- 5: capaciteit error -->
    <!-- 6: operationele input -->
    <!-- 7: operationele error -->
    <!-- 8: productie input -->
    <!-- 9: productie error -->
    <!-- 10: form error -->
    <!-- 11: buttons -->
    <rowConstraints>
        <RowConstraints vgrow="NEVER" prefHeight="30.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="18.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="30.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="18.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="30.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="18.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="30.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="18.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="30.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="18.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="26.0"/>
        <RowConstraints vgrow="NEVER" prefHeight="60.0"/>
    </rowConstraints>

    <padding>
        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
    </padding>

    <children>
        <!-- Naam -->
        <Label text="Naam:" GridPane.rowIndex="0"/>
        <TextField fx:id="naamTxt" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="1.7976931348623157E308"/>
        <Label fx:id="naamErrorLbl" textFill="RED" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="1.7976931348623157E308"/>

        <!-- Locatie -->
        <Label text="Locatie:" GridPane.rowIndex="2"/>
        <TextField fx:id="locatieTxt" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="1.7976931348623157E308"/>
        <Label fx:id="locatieErrorLbl" textFill="RED" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="1.7976931348623157E308"/>

        <!-- Capaciteit -->
        <Label text="Capaciteit:" GridPane.rowIndex="4"/>
        <TextField fx:id="capaciteitTxt" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="1.7976931348623157E308"/>
        <Label fx:id="capaciteitErrorLbl" textFill="RED" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="1.7976931348623157E308"/>

        <!-- Operationele status -->
        <Label text="Operationele status:" GridPane.rowIndex="6"/>
        <ComboBox fx:id="operationeleBx" GridPane.columnIndex="1" GridPane.rowIndex="6" maxWidth="1.7976931348623157E308"/>
        <Label fx:id="operationeleErrorLbl" textFill="RED" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="7" maxWidth="1.7976931348623157E308"/>

        <!-- Productiestatus -->
        <Label text="Productiestatus:" GridPane.rowIndex="8"/>
        <ComboBox fx:id="productieBx" GridPane.columnIndex="1" GridPane.rowIndex="8" maxWidth="1.7976931348623157E308"/>
        <Label fx:id="productieErrorLbl" textFill="RED" wrapText="true"
               GridPane.columnIndex="1" GridPane.rowIndex="9" maxWidth="1.7976931348623157E308"/>

        <!-- Algemene fout -->
        <Label fx:id="formErrorLbl" textFill="RED" wrapText="true"
               GridPane.columnSpan="2" GridPane.rowIndex="10" maxWidth="1.7976931348623157E308"/>

        <!-- Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0"
              GridPane.columnIndex="1" GridPane.rowIndex="11"
              maxWidth="1.7976931348623157E308">
            <children>
                <Button fx:id="saveBtn" mnemonicParsing="false" onAction="#onSave" text="Opslaan"/>
                <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#onCancel" text="Annuleer"/>
            </children>
        </HBox>

    </children>
</GridPane>