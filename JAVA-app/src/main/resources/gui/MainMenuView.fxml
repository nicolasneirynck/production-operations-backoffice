<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MainMenuController">
   <children>
      <Label text="Hoofdmenu">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="gebruikersBhrnBtn" mnemonicParsing="false" onAction="#onGebruikersBhrn" text="Gebruikers Beheren">
         <VBox.margin>
            <Insets bottom="5.0" top="10.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="takenBhrnBtn" mnemonicParsing="false" onAction="#onTakenBhrn" text="Taken Beheren">
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="sitesBhrnBtn" mnemonicParsing="false" onAction="#onSitesBhrn" text="Sites Beheren">
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Label fx:id="errorLbl" textFill="RED" />
   </children>
</VBox>
