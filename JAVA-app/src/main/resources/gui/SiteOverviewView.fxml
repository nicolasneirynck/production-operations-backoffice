<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.SiteOverviewController">
   <center>
      <TableView fx:id="siteTable" prefHeight="233.0" prefWidth="600.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="47.0" text="SiteID" />
          <TableColumn fx:id="naamCol" prefWidth="103.0" text="Naam" />
            <TableColumn fx:id="locatieCol" prefWidth="104.0" text="Locatie" />
            <TableColumn fx:id="capaciteitCol" prefWidth="73.0" text="Capaciteit" />
            <TableColumn fx:id="operationeleCol" prefWidth="127.0" text="Operationele Status" />
            <TableColumn fx:id="productieCol" prefWidth="145.0" text="Productie Status" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="addBtn" mnemonicParsing="false" onAction="#onAdd" text="+" />
            <Button fx:id="editBtn" mnemonicParsing="false" onAction="#onEdit" text="Wijzig" />
            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" text="Verwijder" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#onRefresh" text="Button">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
