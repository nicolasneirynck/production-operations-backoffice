<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="300.0" minWidth="500.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.GebruikerOverviewController">
   <center>
      <TableView fx:id="gebruikerTable" prefHeight="233.0" prefWidth="600.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="108.0" text="Id" />
          <TableColumn fx:id="naamCol" prefWidth="111.0" text="Naam" />
            <TableColumn fx:id="voornaamCol" prefWidth="118.0" text="Voornaam" />
            <TableColumn fx:id="rolCol" prefWidth="127.0" text="Rol" />
            <TableColumn fx:id="statusCol" prefWidth="135.0" text="Status" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button fx:id="addBtn" mnemonicParsing="false" onAction="#onAdd" text="+" />
            <Button fx:id="editBtn" mnemonicParsing="false" onAction="#onEdit" text="Wijzig" />
            <Button fx:id="deleteBtn" mnemonicParsing="false" onAction="#onDelete" text="Verwijder" />
         </children>
      </HBox>
   </bottom>
   <top>
      <HBox prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </top>
</BorderPane>
