<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/17.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.sites.SiteFormController"
      fx:id="root"
      spacing="10">

    <styleClass>
        <String fx:value="card"/>
        <String fx:value="form-card"/>
    </styleClass>

    <Label fx:id="titleLabel" text="Site aanmaken" styleClass="card-title"/>

    <HBox spacing="18">

        <!-- LINKS: Algemene gegevens -->
        <VBox spacing="8" prefWidth="320" minWidth="320" maxWidth="320">
            <Label text="Algemene gegevens" styleClass="section-title"/>

            <GridPane hgap="4" vgap="4">
                <columnConstraints>
                    <!-- iets smaller zodat label + input dichter bij elkaar zitten -->
                    <ColumnConstraints prefWidth="120" hgrow="NEVER" halignment="LEFT"/>
                    <!-- fillWidth is belangrijk -->
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Site naam -->
                <Label text="Site naam" styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <TextField fx:id="naamTf" promptText="bv. Gent Plant" maxWidth="Infinity"/>
                    <Label fx:id="naamErr" styleClass="error-label"/>
                </VBox>

                <!-- Capaciteit -->
                <Label text="Capaciteit" styleClass="form-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <TextField fx:id="capaciteitTf" promptText="bv. 120" maxWidth="Infinity"/>
                    <Label fx:id="capaciteitErr" styleClass="error-label"/>
                </VBox>

                <!-- Operationele status -->
                <Label text="Operationele status" styleClass="form-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <ComboBox fx:id="operationeelCb" maxWidth="Infinity"/>
                    <Label fx:id="operationeelErr" styleClass="error-label"/>
                </VBox>

                <!-- Productie status -->
                <Label text="Productie status" styleClass="form-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <ComboBox fx:id="productieCb" maxWidth="Infinity"/>
                    <Label fx:id="productieErr" styleClass="error-label"/>
                </VBox>

            </GridPane>
        </VBox>

        <!-- RECHTS: Adres -->
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Adres" styleClass="section-title"/>

            <GridPane hgap="4" vgap="4" alignment="TOP_LEFT">
                <columnConstraints>
                    <ColumnConstraints prefWidth="70" hgrow="NEVER" halignment="LEFT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints prefWidth="40" hgrow="NEVER" halignment="LEFT"/>
                    <!-- nr veld iets breder maar mag niet forceren -->
                    <ColumnConstraints prefWidth="110" hgrow="NEVER"/>
                </columnConstraints>

                <!-- Straat -->
                <Label text="Straat" styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <TextField fx:id="straatTf" maxWidth="Infinity"/>
                    <Label fx:id="straatErr" styleClass="error-label"/>
                </VBox>

                <!-- Nummer -->
                <Label text="Nr" styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="3">
                    <TextField fx:id="nummerTf" maxWidth="Infinity"/>
                    <Label fx:id="nummerErr" styleClass="error-label"/>
                </VBox>

                <!-- Postcode -->
                <Label text="Postcode" styleClass="form-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
                    <TextField fx:id="postcodeTf" promptText="bv. 9000" maxWidth="Infinity"/>
                    <Label fx:id="postcodeErr" styleClass="error-label"/>
                </VBox>

                <!-- Stad -->
                <Label text="Stad" styleClass="form-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="2" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="1" GridPane.columnIndex="3">
                    <TextField fx:id="stadTf" maxWidth="Infinity"/>
                    <Label fx:id="stadErr" styleClass="error-label"/>
                </VBox>

                <!-- Land -->
                <Label text="Land" styleClass="form-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="CENTER"/>
                <VBox spacing="2" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.hgrow="ALWAYS">
                    <ComboBox fx:id="landCb" maxWidth="Infinity"/>
                    <Label fx:id="landErr" styleClass="error-label"/>
                </VBox>

            </GridPane>
        </VBox>

    </HBox>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="form-actions">
        <Button fx:id="saveBtn" text="Opslaan" onAction="#onSave" styleClass="btn-primary"/>
        <Button fx:id="cancelBtn" text="✖" onAction="#onCancel" styleClass="btn-ghost"/>
    </HBox>

</VBox>