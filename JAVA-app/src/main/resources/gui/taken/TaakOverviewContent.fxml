<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.taken.TaakOverviewController"
            spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Taken beheren" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addBtn"
                text="+ Nieuwe Taak"
                onAction="#onAdd"
                styleClass="btn-primary"/>
    </HBox>

    <VBox fx:id="formHost"
          spacing="12"
          visible="false"
          managed="false"/>

    <TableView fx:id="taakTable" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="typeCol" text="Taak Type" prefWidth="150"/>
            <TableColumn fx:id="omschrijvingCol" text="Omschrijving" prefWidth="300"/>
            <TableColumn fx:id="duurtijdCol" text="Duurtijd (minuten)" prefWidth="140"/>
            <TableColumn fx:id="actiesCol" text="Acties" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
