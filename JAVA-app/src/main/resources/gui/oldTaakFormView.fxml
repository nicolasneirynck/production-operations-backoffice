<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="10.0" vgap="6.0"
          xmlns="http://javafx.com/javafx/17.0.6"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="gui.taken.TaakFormController">
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="ALWAYS" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
    </rowConstraints>

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <ComboBox fx:id="typeBx" maxWidth="1.7976931348623157E308"
              GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label fx:id="typeErrorLbl" textFill="RED" wrapText="true"
           GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Omschrijving:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextArea fx:id="omschrijvingTxt" wrapText="true" prefRowCount="3"
              maxWidth="1.7976931348623157E308"
              GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Label fx:id="omschrijvingErrorLbl" textFill="RED" wrapText="true"
           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Label text="Duurtijd (min):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="duurtijdBx" maxWidth="1.7976931348623157E308"
              GridPane.rowIndex="5" GridPane.columnIndex="1"/>
<!--    <Label fx:id="duurtijdErrorLbl" textFill="RED" wrapText="true"-->
<!--           GridPane.rowIndex="6" GridPane.columnIndex="1"/>-->
    <Label fx:id="formErrorLbl" textFill="RED" wrapText="true"
           GridPane.rowIndex="7" GridPane.columnSpan="2"/>
    <HBox alignment="CENTER_RIGHT" spacing="10"
          GridPane.rowIndex="8" GridPane.columnIndex="1">
        <Button fx:id="saveBtn" text="Opslaan" onAction="#onSave"/>
        <Button fx:id="cancelBtn" text="Annuleer" onAction="#onCancel"/>
    </HBox>
</GridPane>
