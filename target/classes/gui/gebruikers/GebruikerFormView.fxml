<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.gebruikers.GebruikerFormController"
      spacing="18">

    <styleClass>
        <String fx:value="card"/>
        <String fx:value="form-card"/>
    </styleClass>

    <Label fx:id="titleLabel" text="Gebruiker aanmaken" styleClass="card-title"/>

    <HBox spacing="24">
        <VBox spacing="8" prefWidth="380" maxWidth="380">
            <Label text="Persoonlijke gegevens" styleClass="section-title"/>

            <GridPane hgap="8" vgap="6">
                <columnConstraints>
                    <ColumnConstraints prefWidth="145"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Naam" styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <TextField fx:id="naamTxt" maxWidth="Infinity"/>
                    <Label fx:id="naamErr" styleClass="error-label"/>
                </VBox>

                <Label text="Voornaam" styleClass="form-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="voornaamTxt" maxWidth="Infinity"/>
                    <Label fx:id="voornaamErr" styleClass="error-label"/>
                </VBox>

                <Label text="Geboortedatum" styleClass="form-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <DatePicker fx:id="geboorteDatumDp" maxWidth="Infinity"/>
                    <Label fx:id="geboorteDatumErr" styleClass="error-label"/>
                </VBox>

                <Label text="Straat" styleClass="form-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <TextField fx:id="straatTxt" maxWidth="Infinity"/>
                    <Label fx:id="straatErr" styleClass="error-label"/>
                </VBox>

                <Label text="Nummer" styleClass="form-label"
                       GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="4" GridPane.columnIndex="1">
                    <TextField fx:id="nummerTxt" maxWidth="Infinity"/>
                    <Label fx:id="nummerErr" styleClass="error-label"/>
                </VBox>

                <Label text="Postcode" styleClass="form-label"
                       GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="5" GridPane.columnIndex="1">
                    <TextField fx:id="postcodeTxt" maxWidth="Infinity"/>
                    <Label fx:id="postcodeErr" styleClass="error-label"/>
                </VBox>

                <Label text="Gemeente" styleClass="form-label"
                       GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="6" GridPane.columnIndex="1">
                    <TextField fx:id="gemeenteTxt" maxWidth="Infinity"/>
                    <Label fx:id="gemeenteErr" styleClass="error-label"/>
                </VBox>

                <Label text="Land" styleClass="form-label"
                       GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="7" GridPane.columnIndex="1">
                    <ComboBox fx:id="landCb" maxWidth="Infinity"/>
                    <Label fx:id="landErr" styleClass="error-label"/>
                </VBox>
            </GridPane>
        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Toegang &amp; contact" styleClass="section-title"/>

            <GridPane hgap="8" vgap="6">
                <columnConstraints>
                    <ColumnConstraints prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="E-mail" styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <TextField fx:id="emailTxt" maxWidth="Infinity"/>
                    <Label fx:id="emailErr" styleClass="error-label"/>
                </VBox>

                <Label text="Gsm" styleClass="form-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="gsmTxt" promptText="optioneel" maxWidth="Infinity"/>
                    <Label fx:id="gsmErr" styleClass="error-label"/>
                </VBox>

                <Label text="Wachtwoord" styleClass="form-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <TextField fx:id="wachtwoordTxt" maxWidth="Infinity"/>
                    <Label fx:id="wachtwoordErr" styleClass="error-label"/>
                </VBox>

                <Label text="Status" styleClass="form-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <ComboBox fx:id="statusBx" maxWidth="Infinity"/>
                    <Label fx:id="statusErr" styleClass="error-label"/>
                </VBox>

                <Label text="Rol" styleClass="form-label"
                       GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                <VBox spacing="2" GridPane.rowIndex="4" GridPane.columnIndex="1">
                    <ComboBox fx:id="rolBx" maxWidth="Infinity"/>
                    <Label fx:id="rolErr" styleClass="error-label"/>
                </VBox>
            </GridPane>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Annuleren" onAction="#onCancel" styleClass="btn-ghost"/>
        <Button fx:id="saveBtn" text="Opslaan" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>

</VBox>
