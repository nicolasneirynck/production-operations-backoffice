<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.gebruikers.GebruikerOverviewController"
      spacing="18">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Gebruikers beheren" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addBtn"
                text="+ Nieuwe Gebruiker"
                onAction="#onAdd"
                styleClass="btn-primary"/>
    </HBox>

    <VBox fx:id="formHost"
          spacing="12"
          visible="false"
          managed="false"/>

    <TableView fx:id="gebruikerTable" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="naamCol" text="Naam" prefWidth="180"/>
            <TableColumn fx:id="voornaamCol" text="Voornaam" prefWidth="180"/>
            <TableColumn fx:id="rolCol" text="Rol" prefWidth="140"/>
            <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
            <TableColumn fx:id="actiesCol" text="Acties" prefWidth="70"/>
        </columns>
    </TableView>

</VBox>
